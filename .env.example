# PostgreSQL connection string.
# Local Postgres:      postgresql://USER:PASSWORD@localhost:5432/treinta_clone?schema=public
# Supabase:            postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
# Neon:                postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treinta_clone?schema=public"

# Used to seed the first business/user and to sign session cookies (change in production)
SESSION_SECRET="change-this-to-a-long-random-string"

# Clave de la API de Gemini, usada para leer facturas y notas de venta desde
# una foto. Se genera gratis en https://aistudio.google.com/apikey y NO pide
# tarjeta de credito ni habilitar facturacion.
GEMINI_API_KEY=""

# Modelo a usar. Se puede dejar vacio: por defecto usa gemini-2.5-flash.
# No pongas gemini-1.5-flash: la serie 1.5 quedo fuera de alcance para los
# proyectos nuevos de la API y una clave recien creada responde 404.
GEMINI_MODEL=""

# Si dejas GEMINI_API_KEY vacia y NO estas en produccion, /documentos entra en
# "modo de prueba": no lee la foto y devuelve una factura simulada, para probar
# el flujo sin darse de alta en ningun lado. Pon VISION_MOCK="off" (o "false",
# "0", "no") si prefieres ver el error de credenciales en su lugar. En
# produccion el mock nunca se activa: sin clave la lectura queda desactivada.
VISION_MOCK=""
