# PostgreSQL connection string.
# Local Postgres:      postgresql://USER:PASSWORD@localhost:5432/treinta_clone?schema=public
# Supabase:            postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
# Neon:                postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treinta_clone?schema=public"

# Used to seed the first business/user and to sign session cookies (change in production)
SESSION_SECRET="change-this-to-a-long-random-string"

# Ruta al JSON de la cuenta de servicio de Google Cloud, usada para leer
# facturas y notas de venta con Cloud Vision (capa gratuita: 1000 paginas/mes).
# Crea la cuenta de servicio con el rol "Cloud Vision AI Service Agent" y
# descarga su clave JSON.
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# Si dejas la variable de arriba vacia y NO estas en produccion, /documentos
# entra en "modo de prueba": no lee la foto y devuelve una factura simulada,
# para probar el flujo sin cuenta de Google. Pon VISION_MOCK="off" (o "false",
# "0", "no") si prefieres ver el error de credenciales en su lugar. En
# produccion el mock nunca se activa: sin credenciales la lectura queda
# desactivada.
#
# OJO: la ruta de arriba se resuelve con existsSync() desde la raiz del
# proyecto. Si no coincide con el nombre real del archivo, la app cae en modo
# de prueba en silencio. En Windows revisa que no haya quedado .json.json.
VISION_MOCK=""
